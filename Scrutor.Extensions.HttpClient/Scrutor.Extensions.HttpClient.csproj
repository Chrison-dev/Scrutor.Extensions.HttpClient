<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Label="Package">
		<Title>Scrutor HttpClient Extension</Title>
		<Authors>Chrison Simtian</Authors>
		<Copyright>$(CurrentYear) - $(Company)</Copyright>
		<Description>Allows you to register HttpClients via Scrutor</Description>
		<PackageProjectUrl>https://github.com/Chrison-dev/Scrutor.Extensions.HttpClient</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Chrison-dev/Scrutor.Extensions.HttpClient.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IncludeSymbols>False</IncludeSymbols>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Label="Nuget Packages">
		<!-- Limit to 9.x -->
		<PackageReference Include="Microsoft.Extensions.Http" Version="[9.0.0, 10.0.0)" />

		<!-- Limit to 5.x due to breaking change in 6.x. Moving to Scrutor 7.x is a
		     tracked modernization task, not part of this CI/publishing pass. -->
		<PackageReference Include="Scrutor" Version="[5.1.2, 6.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Scrutor.Extensions.HttpClient.Specs" />
	</ItemGroup>

</Project>

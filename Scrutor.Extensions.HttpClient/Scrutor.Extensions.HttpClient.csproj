<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Label="Target Frameworks">
		<!-- netstandard2.0 for max reach (net462+, .NET Core 2+, Mono, …); net8.0 for modern
		     consumers. Overrides the single TFM in the root Directory.Build.props. Both Scrutor 7
		     and Microsoft.Extensions.Http support these targets. LangVersion lets us use modern
		     C# (primary constructors, list patterns) even on the netstandard2.0 target. -->
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<TargetFramework></TargetFramework>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup Label="Package">
		<Title>Scrutor HttpClient Extension</Title>
		<Authors>Chrison Simtian</Authors>
		<Copyright>$(CurrentYear) - $(Company)</Copyright>
		<Description>Allows you to register HttpClients via Scrutor</Description>
		<PackageProjectUrl>https://github.com/Chrison-dev/Scrutor.Extensions.HttpClient</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Chrison-dev/Scrutor.Extensions.HttpClient.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IncludeSymbols>False</IncludeSymbols>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Label="Nuget Packages">
		<PackageReference Include="Microsoft.Extensions.Http" Version="[9.0.0, 11.0.0)" />

		<!-- Aligned with Scrutor's major: package 7.x ↔ Scrutor 7.x. -->
		<PackageReference Include="Scrutor" Version="[7.0.0, 8.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Scrutor.Extensions.HttpClient.Specs" />
	</ItemGroup>

</Project>

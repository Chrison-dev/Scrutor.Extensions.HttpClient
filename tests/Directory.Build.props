<Project>
    <Import Project="$(MSBuildThisFileDirectory)\..\Directory.Build.props" />

    <!-- Test stack for *.Specs projects: xUnit + FluentAssertions + Verify +
         PublicApiGenerator (Roslyn public-API baseline). Versions are per-package
         on purpose (no Central Package Management). Mirrors the Fallout/TVDB
         convention of injecting the test stack so each spec csproj stays tiny.
         (NetArchTest/Mockly are omitted here: this is a single public class with
         no architecture layers to enforce and no interface collaborator to mock —
         the extension's only collaborator is the static AddHttpClient API. Specs
         exercise the real DI container + a stub HttpMessageHandler instead.) -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Specs'))">
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Specs'))">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Verify.Xunit" Version="31.7.1" />
        <PackageReference Include="PublicApiGenerator" Version="11.4.6" />
        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
